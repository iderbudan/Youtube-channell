PORT=8080
# Апп болон QPay callback-д ашиглагдах таны серверийн гадаад хаяг
PUBLIC_URL=https://api.cleanmn.mn

# QPay v2 (merchant гэрээ хийхэд QPay-ээс өгнө). Sandbox-ийн тест утгууд:
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=TEST_MERCHANT
QPAY_PASSWORD=123456
QPAY_INVOICE_CODE=TEST_INVOICE
# QPay_USERNAME хоосон бол QPay-г дуурайлгасан "fake" горимд ажиллана.

# Захиалгын төлөв өөрчлөх админ токен (урт санамсаргүй утга)
ADMIN_TOKEN=change-me
# callback URL-д нэмэгдэх нууц (QPay-ээс ирсэн эсэхийг шалгахад)
CALLBACK_SECRET=change-me-too
